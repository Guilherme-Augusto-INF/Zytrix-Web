rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==================================================
    // FUNÇÕES GERAIS
    // ==================================================

    function loggedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return loggedIn()
        && request.auth.uid == uid;
    }

    function isAdminUid(uid) {
      return exists(
          /databases/$(database)/documents/admins/$(uid)
        )
        && get(
          /databases/$(database)/documents/admins/$(uid)
        ).data.active == true;
    }

    function isAdmin() {
      return loggedIn()
        && isAdminUid(request.auth.uid);
    }

    // Garante que o e-mail/provedor gravado em users/{uid}
    // realmente corresponde ao usuário autenticado.
    function validAuthIdentity(data) {
      return loggedIn()

        && request.auth.token.email is string

        && data.email
            == request.auth.token.email

        && (
          (
            request.auth.token.firebase.sign_in_provider
                == "password"

            && data.provider
                == "password"
          )

          ||

          (
            request.auth.token.firebase.sign_in_provider
                == "google.com"

            && data.provider
                == "google"
          )
        );
    }

    function validUsername(username) {
      return username is string
        && username.size() >= 2
        && username.size() <= 30;
    }

    function validBio(bio) {
      return bio is string
        && bio.size() <= 500;
    }

    function validPhotoURL(url) {
      return url is string
        && url.size() <= 2048;
    }


    // ==================================================
    // MODERAÇÃO GLOBAL - FUNÇÕES
    // ==================================================

    function hasActivePenalty(uid) {
      return exists(
          /databases/$(database)/documents/moderationPenalties/$(uid)
        )

        && get(
          /databases/$(database)/documents/moderationPenalties/$(uid)
        ).data.active == true

        && (
          get(
            /databases/$(database)/documents/moderationPenalties/$(uid)
          ).data.expiresAt == null

          ||

          get(
            /databases/$(database)/documents/moderationPenalties/$(uid)
          ).data.expiresAt > request.time
        );
    }

    function isBanned(uid) {
      return hasActivePenalty(uid)

        && get(
          /databases/$(database)/documents/moderationPenalties/$(uid)
        ).data.type == "ban";
    }

    function isChatRestricted(uid) {
      return hasActivePenalty(uid)

        && (
          get(
            /databases/$(database)/documents/moderationPenalties/$(uid)
          ).data.type == "ban"

          ||

          get(
            /databases/$(database)/documents/moderationPenalties/$(uid)
          ).data.type == "mute"
        );
    }


    // ==================================================
    // ZY COINS - FUNÇÕES AUXILIARES
    // ==================================================

    function validCoinAmount(amount) {
      return amount is int
        && amount >= 1
        && amount <= 100000;
    }

    function validSupportAlertSound(sound) {
      return sound in ["coin", "bell", "pop", "soft", "none"];
    }

    function validWalletShape(data, uid) {
      return data.uid == uid

        && data.balance is int
        && data.balance >= 0

        && data.totalSent is int
        && data.totalSent >= 0

        && data.totalReceived is int
        && data.totalReceived >= 0

        && data.lastTransactionId is string
        && data.lastTransactionId.size() <= 128

        && data.createdAt is timestamp
        && data.updatedAt is timestamp

        && data.keys().hasAll([
          "uid",
          "balance",
          "totalSent",
          "totalReceived",
          "lastTransactionId",
          "createdAt",
          "updatedAt"
        ])

        && data.keys().hasOnly([
          "uid",
          "balance",
          "totalSent",
          "totalReceived",
          "lastTransactionId",
          "createdAt",
          "updatedAt"
        ]);
    }

    function validCoinPackage(packageId, coins, priceCents) {
      return
        (
          packageId == "zy100"
          && coins == 100
          && priceCents == 490
        )

        ||

        (
          packageId == "zy500"
          && coins == 500
          && priceCents == 1490
        )

        ||

        (
          packageId == "zy1200"
          && coins == 1200
          && priceCents == 2990
        )

        ||

        (
          packageId == "zy2500"
          && coins == 2500
          && priceCents == 4990
        );
    }

    function validSenderWalletUpdate(uid) {
      let txId = request.resource.data.lastTransactionId;

      let tx = getAfter(
        /databases/$(database)/documents/zyCoinTransactions/$(txId)
      ).data;

      return isOwner(uid)

        && validWalletShape(
          request.resource.data,
          uid
        )

        && request.resource.data.uid
            == resource.data.uid

        && request.resource.data.createdAt
            == resource.data.createdAt

        && request.resource.data.updatedAt
            == request.time

        && tx.transactionId
            == txId

        && tx.type
            == "stream_support"

        && tx.status
            == "completed"

        && tx.fromUid
            == uid

        && tx.toUid
            != uid

        && validCoinAmount(
          tx.amount
        )

        && request.resource.data.balance
            == resource.data.balance - tx.amount

        && request.resource.data.totalSent
            == resource.data.totalSent + tx.amount

        && request.resource.data.totalReceived
            == resource.data.totalReceived

        && request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasOnly([
              "balance",
              "totalSent",
              "lastTransactionId",
              "updatedAt"
            ]);
    }

    function validRecipientWalletUpdate(uid) {
      let txId = request.resource.data.lastTransactionId;

      let tx = getAfter(
        /databases/$(database)/documents/zyCoinTransactions/$(txId)
      ).data;

      return loggedIn()

        && request.auth.uid != uid

        && validWalletShape(
          request.resource.data,
          uid
        )

        && request.resource.data.uid
            == resource.data.uid

        && request.resource.data.createdAt
            == resource.data.createdAt

        && request.resource.data.updatedAt
            == request.time

        && tx.transactionId
            == txId

        && tx.type
            == "stream_support"

        && tx.status
            == "completed"

        && tx.fromUid
            == request.auth.uid

        && tx.toUid
            == uid

        && validCoinAmount(
          tx.amount
        )

        && request.resource.data.balance
            == resource.data.balance + tx.amount

        && request.resource.data.totalSent
            == resource.data.totalSent

        && request.resource.data.totalReceived
            == resource.data.totalReceived + tx.amount

        && request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasOnly([
              "balance",
              "totalReceived",
              "lastTransactionId",
              "updatedAt"
            ]);
    }

    function validRecipientWalletCreate(uid) {
      let txId = request.resource.data.lastTransactionId;

      let tx = getAfter(
        /databases/$(database)/documents/zyCoinTransactions/$(txId)
      ).data;

      return loggedIn()

        && request.auth.uid != uid

        && validWalletShape(
          request.resource.data,
          uid
        )

        && request.resource.data.createdAt
            == request.time

        && request.resource.data.updatedAt
            == request.time

        && tx.transactionId
            == txId

        && tx.type
            == "stream_support"

        && tx.status
            == "completed"

        && tx.fromUid
            == request.auth.uid

        && tx.toUid
            == uid

        && validCoinAmount(
          tx.amount
        )

        && request.resource.data.balance
            == 500 + tx.amount

        && request.resource.data.totalSent
            == 0

        && request.resource.data.totalReceived
            == tx.amount;
    }

    function validSupportTransactionCreate(transactionId) {
      let data = request.resource.data;

      let streamPath =
        /databases/$(database)/documents/streams/$(data.streamId);

      let senderPath =
        /databases/$(database)/documents/wallets/$(data.fromUid);

      let recipientPath =
        /databases/$(database)/documents/wallets/$(data.toUid);

      let senderBefore =
        get(senderPath).data;

      let senderAfter =
        getAfter(senderPath).data;

      let recipientAfter =
        getAfter(recipientPath).data;

      return loggedIn()

        && !isBanned(
          request.auth.uid
        )

        && data.transactionId
            == transactionId

        && data.fromUid
            == request.auth.uid

        && data.toUid is string
        && data.toUid.size() > 0
        && data.toUid != data.fromUid

        && data.streamId is string
        && data.streamId.size() > 0

        && validCoinAmount(
          data.amount
        )

        && data.type
            == "stream_support"

        && data.status
            == "completed"

        && data.createdAt
            == request.time

        && data.keys().hasAll([
          "transactionId",
          "fromUid",
          "toUid",
          "streamId",
          "amount",
          "type",
          "status",
          "createdAt"
        ])

        && data.keys().hasOnly([
          "transactionId",
          "fromUid",
          "toUid",
          "streamId",
          "amount",
          "type",
          "status",
          "createdAt"
        ])

        && exists(
          streamPath
        )

        && get(streamPath).data.streamerUid
            == data.toUid

        && get(streamPath).data.status
            == "live"

        && exists(
          senderPath
        )

        && senderBefore.balance
            is int

        && senderBefore.balance
            >= data.amount

        && senderAfter.uid
            == data.fromUid

        && senderAfter.createdAt
            == senderBefore.createdAt

        && senderAfter.updatedAt
            == request.time

        && senderAfter.lastTransactionId
            == transactionId

        && senderAfter.balance
            == senderBefore.balance - data.amount

        && senderAfter.totalSent
            == senderBefore.totalSent + data.amount

        && senderAfter.totalReceived
            == senderBefore.totalReceived

        && recipientAfter.uid
            == data.toUid

        && recipientAfter.updatedAt
            == request.time

        && recipientAfter.lastTransactionId
            == transactionId

        && (
          (
            exists(
              recipientPath
            )

            && recipientAfter.createdAt
                == get(recipientPath).data.createdAt

            && recipientAfter.balance
                == get(recipientPath).data.balance
                   + data.amount

            && recipientAfter.totalSent
                == get(recipientPath).data.totalSent

            && recipientAfter.totalReceived
                == get(recipientPath).data.totalReceived
                   + data.amount
          )

          ||

          (
            !exists(
              recipientPath
            )

            && recipientAfter.createdAt
                == request.time

            && recipientAfter.balance
                == 500 + data.amount

            && recipientAfter.totalSent
                == 0

            && recipientAfter.totalReceived
                == data.amount
          )
        );
    }


    // ==================================================
    // ADMINS
    // ==================================================

    // ATENÇÃO:
    // Esta coleção permanece legível porque o frontend
    // usa admins/{uid} para badges e controle visual.
    //
    // Não armazenar email, nome, telefone ou dados
    // pessoais aqui. Use somente campos operacionais
    // mínimos, como:
    //
    // active: true
    //
    match /admins/{uid} {

      allow read:
        if true;

      allow create, update, delete:
        if false;
    }


    // ==================================================
    // USERS - DADOS PRIVADOS DE CONTA
    // ==================================================

    match /users/{uid} {

      allow read:
        if isOwner(uid)
        || isAdmin();


      allow create:
        if isOwner(uid)

        && validAuthIdentity(
          request.resource.data
        )

        && request.resource.data.uid
            == uid

        && request.resource.data.zytrixId
            is string

        && request.resource.data.zytrixId.size()
            >= 5

        && request.resource.data.zytrixId.size()
            <= 64

        && request.resource.data.email
            is string

        && request.resource.data.email.size()
            <= 320

        && (
          request.resource.data.provider
              == "password"

          ||

          request.resource.data.provider
              == "google"
        )

        && request.resource.data.createdAt
            == request.time

        && request.resource.data.lastLoginAt
            == request.time

        && request.resource.data.keys().hasAll([
          "uid",
          "zytrixId",
          "email",
          "provider",
          "createdAt",
          "lastLoginAt"
        ])

        && request.resource.data.keys().hasOnly([
          "uid",
          "zytrixId",
          "email",
          "provider",
          "createdAt",
          "lastLoginAt"
        ]);


      allow update:
        if
        (
          isOwner(uid)

          && validAuthIdentity(
            request.resource.data
          )

          && request.resource.data.uid
              == resource.data.uid

          && request.resource.data.provider
              == resource.data.provider

          && request.resource.data.createdAt
              == resource.data.createdAt

          && request.resource.data.lastLoginAt
              == request.time

          && request.resource.data.email
              is string

          && (
            (
              resource.data.keys().hasAll([
                "zytrixId"
              ])

              && request.resource.data.zytrixId
                  == resource.data.zytrixId

              && request.resource.data
                  .diff(resource.data)
                  .affectedKeys()
                  .hasOnly([
                    "email",
                    "lastLoginAt"
                  ])
            )

            ||

            (
              !resource.data.keys().hasAll([
                "zytrixId"
              ])

              && request.resource.data.zytrixId
                  is string

              && request.resource.data.zytrixId.size()
                  >= 5

              && request.resource.data.zytrixId.size()
                  <= 64

              && request.resource.data
                  .diff(resource.data)
                  .affectedKeys()
                  .hasOnly([
                    "email",
                    "lastLoginAt",
                    "zytrixId"
                  ])
            )
          )
        )

        ||

        (
          isAdmin()

          && request.resource.data.uid
              == resource.data.uid

          && request.resource.data.zytrixId
              == resource.data.zytrixId

          && request.resource.data.provider
              == resource.data.provider

          && request.resource.data.createdAt
              == resource.data.createdAt

          && request.resource.data
              .diff(resource.data)
              .affectedKeys()
              .hasOnly([
                "email",
                "lastLoginAt"
              ])
        );


      allow delete:
        if isOwner(uid)
        || isAdmin();


      // ================================================
      // SEGUINDO
      // ================================================

      match /following/{channelId} {

        allow read:
          if isOwner(uid)
          || isAdmin();

        allow create:
          if isOwner(uid)

          && !isBanned(uid)

          && request.resource.data.channelId
              == channelId

          && request.resource.data.followedAt
              == request.time

          && request.resource.data.keys().hasOnly([
            "channelId",
            "followedAt"
          ]);

        allow update:
          if false;

        allow delete:
          if isOwner(uid)
          || isAdmin();
      }


      // ================================================
      // ESTADO DAS NOTIFICAÇÕES
      // ================================================
      // Documento privado da própria conta usado para
      // sincronizar o estado lido/não lido dos apoios
      // recebidos entre dispositivos.
      // ================================================

      match /notificationState/{stateId} {

        allow read:
          if isOwner(uid)
          || isAdmin();

        allow create, update:
          if isOwner(uid)

          && stateId == "zycoins"

          && request.resource.data.uid
              == uid

          && request.resource.data.lastSupportSeenAt
              == request.time

          && request.resource.data.updatedAt
              == request.time

          && request.resource.data.keys().hasAll([
            "uid",
            "lastSupportSeenAt",
            "updatedAt"
          ])

          && request.resource.data.keys().hasOnly([
            "uid",
            "lastSupportSeenAt",
            "updatedAt"
          ]);

        allow delete:
          if isOwner(uid)
          || isAdmin();
      }


      // ================================================
      // HISTÓRICO
      // ================================================

      match /watchHistory/{streamId} {

        allow read:
          if isOwner(uid)
          || isAdmin();

        allow create, update:
          if isOwner(uid);

        allow delete:
          if isOwner(uid)
          || isAdmin();
      }
    }


    // ==================================================
    // PERFIS
    // ==================================================

    match /profiles/{uid} {

      allow read:
        if true;


      allow create:
        if isOwner(uid)

        && request.resource.data.uid
            == uid

        && validUsername(
          request.resource.data.username
        )

        && validPhotoURL(
          request.resource.data.photoURL
        )

        && validBio(
          request.resource.data.bio
        )

        && request.resource.data.createdAt
            == request.time

        && request.resource.data.usernameUpdatedAt
            == request.time

        && request.resource.data.keys().hasAll([
          "uid",
          "username",
          "photoURL",
          "bio",
          "createdAt",
          "usernameUpdatedAt"
        ])

        && request.resource.data.keys().hasOnly([
          "uid",
          "username",
          "photoURL",
          "bio",
          "createdAt",
          "usernameUpdatedAt"
        ]);


      allow update:
        if
        (
          isOwner(uid)

          && request.resource.data.uid
              == resource.data.uid

          && request.resource.data.createdAt
              == resource.data.createdAt

          && validUsername(
            request.resource.data.username
          )

          && validPhotoURL(
            request.resource.data.photoURL
          )

          && validBio(
            request.resource.data.bio
          )

          && (
            (
              request.resource.data.username
                  == resource.data.username

              && request.resource.data.usernameUpdatedAt
                  == resource.data.usernameUpdatedAt

              && request.resource.data
                  .diff(resource.data)
                  .affectedKeys()
                  .hasOnly([
                    "photoURL",
                    "bio"
                  ])
            )

            ||

            (
              request.resource.data.username
                  != resource.data.username

              && resource.data.usernameUpdatedAt
                  is timestamp

              && request.time
                  >= resource.data.usernameUpdatedAt
                     + duration.value(7, "d")

              && request.resource.data.usernameUpdatedAt
                  == request.time

              && request.resource.data
                  .diff(resource.data)
                  .affectedKeys()
                  .hasOnly([
                    "username",
                    "usernameUpdatedAt",
                    "photoURL",
                    "bio"
                  ])
            )
          )
        )

        ||

        (
          isAdmin()

          && request.resource.data.uid
              == resource.data.uid

          && request.resource.data.createdAt
              == resource.data.createdAt
        );


      allow delete:
        if isOwner(uid)
        || isAdmin();
    }


    // ==================================================
    // CANAIS
    // ==================================================

    match /channels/{channelId} {

      allow read:
        if true;


      allow create:
        if isOwner(channelId)

        && !isBanned(channelId)

        && request.resource.data.ownerUid
            == request.auth.uid

        && request.resource.data.createdAt
            == request.time

        && request.resource.data.keys().hasOnly([
          "ownerUid",
          "channelName",
          "description",
          "avatarURL",
          "bannerURL",
          "categoryId",
          "isLive",
          "currentStreamId",
          "createdAt"
        ]);


      allow update:
        if
        (
          isOwner(channelId)

          && !isBanned(channelId)

          && resource.data.ownerUid
              == request.auth.uid

          && request.resource.data.ownerUid
              == resource.data.ownerUid

          && request.resource.data.createdAt
              == resource.data.createdAt

          && request.resource.data
              .diff(resource.data)
              .affectedKeys()
              .hasOnly([
                "channelName",
                "description",
                "avatarURL",
                "bannerURL",
                "categoryId",
                "isLive",
                "currentStreamId"
              ])
        )

        || isAdmin();


      allow delete:
        if
        (
          isOwner(channelId)

          && resource.data.ownerUid
              == request.auth.uid
        )

        || isAdmin();


      // ================================================
      // SEGUIDORES
      // ================================================

      match /followers/{followerUid} {

        allow read:
          if true;

        allow create:
          if isOwner(followerUid)

          && !isBanned(followerUid)

          && request.resource.data.uid
              == followerUid

          && request.resource.data.followedAt
              == request.time

          && request.resource.data.keys().hasOnly([
            "uid",
            "followedAt"
          ]);

        allow update:
          if false;

        allow delete:
          if isOwner(followerUid)
          || isOwner(channelId)
          || isAdmin();
      }


      // ================================================
      // DADOS PRIVADOS DO CANAL
      // ================================================

      match /private/{documentId} {

        allow read, create, update, delete:
          if isOwner(channelId)
          || isAdmin();
      }
    }


    // ==================================================
    // LIVES
    // ==================================================

    match /streams/{streamId} {

      allow read:
        if true;


      // ================================================
      // CRIAR LIVE
      // ================================================

      allow create:
        if loggedIn()

        && !isBanned(
          request.auth.uid
        )

        && request.resource.data.streamerUid
            == request.auth.uid

        && request.resource.data.channelId
            == request.auth.uid

        && request.resource.data.createdAt
            == request.time

        && request.resource.data.viewerCount
            is int

        && request.resource.data.viewerCount
            == 0

        && (
          !request.resource.data.keys().hasAll([
            "supportAlertSound"
          ])
          || validSupportAlertSound(
            request.resource.data.supportAlertSound
          )
        )

        && (
          !request.resource.data.keys().hasAll([
            "matureContent"
          ])
          || request.resource.data.matureContent is bool
        )

        && request.resource.data.keys().hasAll([
          "streamerUid",
          "channelId",
          "title",
          "description",
          "categoryId",
          "thumbnailURL",
          "status",
          "playbackURL",
          "startedAt",
          "endedAt",
          "createdAt",
          "viewerCount"
        ])

        && request.resource.data.keys().hasOnly([
          "streamerUid",
          "channelId",
          "title",
          "description",
          "categoryId",
          "thumbnailURL",
          "status",
          "playbackURL",
          "startedAt",
          "endedAt",
          "createdAt",
          "viewerCount",
          "supportAlertSound",
          "matureContent"
        ]);


      // ================================================
      // ATUALIZAR LIVE
      // ================================================

      allow update:
        if
        (
          loggedIn()

          && !isBanned(
            request.auth.uid
          )

          && resource.data.streamerUid
              == request.auth.uid

          && request.resource.data.streamerUid
              == resource.data.streamerUid

          && request.resource.data.channelId
              == resource.data.channelId

          && request.resource.data.createdAt
              == resource.data.createdAt

          && request.resource.data.viewerCount
              is int

          && request.resource.data.viewerCount
              == resource.data.viewerCount

          && (
            !request.resource.data.keys().hasAll([
              "supportAlertSound"
            ])
            || validSupportAlertSound(
              request.resource.data.supportAlertSound
            )
          )

          && (
            !request.resource.data.keys().hasAll([
              "matureContent"
            ])
            || request.resource.data.matureContent is bool
          )

          && request.resource.data
              .diff(resource.data)
              .affectedKeys()
              .hasOnly([
                "title",
                "description",
                "categoryId",
                "thumbnailURL",
                "status",
                "playbackURL",
                "startedAt",
                "endedAt",
                "supportAlertSound",
                "matureContent"
              ])
        )

        ||

        (
          isAdmin()

          && request.resource.data.viewerCount
              is int

          && request.resource.data.viewerCount
              >= 0
        );


      // ================================================
      // EXCLUIR LIVE
      // ================================================

      // Mesmo um usuário banido pode excluir seus dados.
      allow delete:
        if
        (
          loggedIn()

          && resource.data.streamerUid
              == request.auth.uid
        )

        || isAdmin();


      // ================================================
      // ALERTAS PÚBLICOS DE APOIO
      // ================================================
      // Evento sanitizado criado na mesma operação
      // atômica da transação stream_support.
      // Não expõe saldo, carteira ou pedido de compra.
      // ================================================

      match /supportAlerts/{alertId} {

        allow read:
          if true;

        allow create:
          if loggedIn()

          && request.resource.data.transactionId
              == alertId

          && request.resource.data.fromUid
              == request.auth.uid

          && request.resource.data.streamId
              == streamId

          && validCoinAmount(
            request.resource.data.amount
          )

          && request.resource.data.createdAt
              == request.time

          && request.resource.data.keys().hasOnly([
            "transactionId",
            "fromUid",
            "streamId",
            "amount",
            "createdAt"
          ])

          && get(
            /databases/$(database)/documents/streams/$(streamId)
          ).data.status == "live"

          && getAfter(
            /databases/$(database)/documents/zyCoinTransactions/$(alertId)
          ).data.transactionId == alertId

          && getAfter(
            /databases/$(database)/documents/zyCoinTransactions/$(alertId)
          ).data.fromUid == request.auth.uid

          && getAfter(
            /databases/$(database)/documents/zyCoinTransactions/$(alertId)
          ).data.toUid == get(
            /databases/$(database)/documents/streams/$(streamId)
          ).data.streamerUid

          && getAfter(
            /databases/$(database)/documents/zyCoinTransactions/$(alertId)
          ).data.streamId == streamId

          && getAfter(
            /databases/$(database)/documents/zyCoinTransactions/$(alertId)
          ).data.amount == request.resource.data.amount

          && getAfter(
            /databases/$(database)/documents/zyCoinTransactions/$(alertId)
          ).data.type == "stream_support"

          && getAfter(
            /databases/$(database)/documents/zyCoinTransactions/$(alertId)
          ).data.status == "completed"

          && getAfter(
            /databases/$(database)/documents/zyCoinTransactions/$(alertId)
          ).data.createdAt == request.time;

        allow update, delete:
          if false;
      }


      // ================================================
      // CHAT EM TEMPO REAL
      // ================================================

      match /chat/{messageId} {

        allow read:
          if true;

        allow create:
          if loggedIn()

          && !isChatRestricted(
            request.auth.uid
          )

          && request.resource.data.uid
              == request.auth.uid

          && request.resource.data.text
              is string

          && request.resource.data.text.size()
              >= 1

          && request.resource.data.text.size()
              <= 300

          && request.resource.data.createdAt
              == request.time

          && get(
            /databases/$(database)/documents/streams/$(streamId)
          ).data.status == "live"

          && (
            !exists(
              /databases/$(database)/documents/streams/$(streamId)/chatBans/$(request.auth.uid)
            )

            ||

            (
              get(
                /databases/$(database)/documents/streams/$(streamId)/chatBans/$(request.auth.uid)
              ).data.expiresAt != null

              && get(
                /databases/$(database)/documents/streams/$(streamId)/chatBans/$(request.auth.uid)
              ).data.expiresAt <= request.time
            )
          )

          && request.resource.data.keys().hasOnly([
            "uid",
            "text",
            "createdAt"
          ]);

        allow update:
          if false;

        allow delete:
          if loggedIn()

          && (
            resource.data.uid
                == request.auth.uid

            || isAdmin()

            ||

            (
              get(
                /databases/$(database)/documents/streams/$(streamId)
              ).data.streamerUid == request.auth.uid

              && !isAdminUid(
                resource.data.uid
              )
            )
          );
      }


      // ================================================
      // MODERAÇÃO DO CHAT
      // ================================================

      match /chatBans/{uid} {

        allow read:
          if loggedIn()

          && (
            request.auth.uid
                == uid

            ||

            get(
              /databases/$(database)/documents/streams/$(streamId)
            ).data.streamerUid == request.auth.uid

            ||

            isAdmin()
          );


        allow create, update:
          if loggedIn()

          && (
            isAdmin()

            ||

            (
              get(
                /databases/$(database)/documents/streams/$(streamId)
              ).data.streamerUid == request.auth.uid

              && !isAdminUid(uid)
            )
          )

          && request.resource.data.uid
              == uid

          && request.resource.data.bannedBy
              == request.auth.uid

          && request.resource.data.reason
              in ["mute", "ban"]

          && request.resource.data.createdAt
              == request.time

          && (
            request.resource.data.expiresAt
                == null

            ||

            request.resource.data.expiresAt
                is timestamp
          )

          && request.resource.data.keys().hasOnly([
            "uid",
            "bannedBy",
            "reason",
            "createdAt",
            "expiresAt"
          ]);


        allow delete:
          if loggedIn()

          && (
            isAdmin()

            ||

            (
              get(
                /databases/$(database)/documents/streams/$(streamId)
              ).data.streamerUid == request.auth.uid

              && !isAdminUid(uid)
            )
          );
      }


      // ================================================
      // MENSAGEM FIXADA
      // ================================================

      match /chatConfig/{docId} {

        allow read:
          if true;

        allow create, update:
          if docId == "main"

          && loggedIn()

          && (
            get(
              /databases/$(database)/documents/streams/$(streamId)
            ).data.streamerUid == request.auth.uid

            ||

            isAdmin()
          )

          && request.resource.data.pinnedMessageId
              is string

          && request.resource.data.pinnedMessageId.size()
              > 0

          && request.resource.data.pinnedMessageId.size()
              <= 128

          && exists(
            /databases/$(database)/documents/streams/$(streamId)/chat/$(request.resource.data.pinnedMessageId)
          )

          && request.resource.data.updatedBy
              == request.auth.uid

          && request.resource.data.updatedAt
              == request.time

          && request.resource.data.keys().hasOnly([
            "pinnedMessageId",
            "updatedBy",
            "updatedAt"
          ]);

        allow delete:
          if docId == "main"

          && loggedIn()

          && (
            get(
              /databases/$(database)/documents/streams/$(streamId)
            ).data.streamerUid == request.auth.uid

            ||

            isAdmin()
          );
      }
    }


    // ==================================================
    // ZY COINS - CARTEIRAS
    // ==================================================

    match /wallets/{uid} {

      allow read:
        if isOwner(uid)
        || isAdmin();


      // ================================================
      // CRIAR CARTEIRA
      // ================================================

      allow create:
        if
        (
          isOwner(uid)

          && validWalletShape(
            request.resource.data,
            uid
          )

          && request.resource.data.balance
              == 500

          && request.resource.data.totalSent
              == 0

          && request.resource.data.totalReceived
              == 0

          && request.resource.data.lastTransactionId
              == ""

          && request.resource.data.createdAt
              == request.time

          && request.resource.data.updatedAt
              == request.time
        )

        ||

        validRecipientWalletCreate(uid)

        ||

        isAdmin();


      // ================================================
      // ATUALIZAR CARTEIRA
      // ================================================

      allow update:
        if validSenderWalletUpdate(uid)
        || validRecipientWalletUpdate(uid)
        || isAdmin();


      // ================================================
      // EXCLUIR CARTEIRA
      // ================================================

      // O titular só pode apagar a carteira junto com
      // users/{uid}. Isso impede apagar e recriar a
      // carteira para receber 500 Zy Coins novamente.
      allow delete:
        if isAdmin()

        ||

        (
          isOwner(uid)

          && !existsAfter(
            /databases/$(database)/documents/users/$(uid)
          )
        );
    }


    // ==================================================
    // ZY COINS - APOIOS
    // ==================================================

    match /zyCoinTransactions/{transactionId} {

      allow read:
        if loggedIn()

        && (
          resource.data.fromUid
              == request.auth.uid

          ||

          resource.data.toUid
              == request.auth.uid

          ||

          isAdmin()
        );


      allow create:
        if validSupportTransactionCreate(
          transactionId
        );


      allow update, delete:
        if false;
    }


    // ==================================================
    // ZY COINS - PEDIDOS
    // ==================================================

    match /zyCoinOrders/{orderId} {

      allow read:
        if loggedIn()

        && (
          resource.data.uid
              == request.auth.uid

          ||

          isAdmin()
        );


      allow create:
        if loggedIn()

        && !isBanned(
          request.auth.uid
        )

        && request.resource.data.uid
            == request.auth.uid

        && validCoinPackage(
          request.resource.data.packageId,
          request.resource.data.coins,
          request.resource.data.priceCents
        )

        && (
          request.resource.data.paymentMethod
              == "pix"

          ||

          request.resource.data.paymentMethod
              == "card"
        )

        && request.resource.data.createdAt
            == request.time

        && request.resource.data.keys().hasAll([
          "uid",
          "packageId",
          "coins",
          "priceCents",
          "paymentMethod",
          "status",
          "mode",
          "createdAt",
          "paidAt"
        ])

        && request.resource.data.keys().hasOnly([
          "uid",
          "packageId",
          "coins",
          "priceCents",
          "paymentMethod",
          "status",
          "mode",
          "createdAt",
          "paidAt"
        ])

        && (
          (
            request.resource.data.status
                == "pending"

            && request.resource.data.mode
                == "prototype"

            && request.resource.data.paidAt
                == null
          )

          ||

          (
            isAdmin()

            && request.resource.data.status
                == "paid"

            && request.resource.data.mode
                == "admin_demo"

            && request.resource.data.paidAt
                == request.time
          )
        );


      allow update:
        if isAdmin()

        && request.resource.data.uid
            == resource.data.uid

        && request.resource.data.packageId
            == resource.data.packageId

        && request.resource.data.coins
            == resource.data.coins

        && request.resource.data.priceCents
            == resource.data.priceCents

        && request.resource.data.paymentMethod
            == resource.data.paymentMethod

        && request.resource.data.createdAt
            == resource.data.createdAt

        && request.resource.data.mode
            == resource.data.mode

        && (
          request.resource.data.status
              == "pending"

          ||

          request.resource.data.status
              == "paid"

          ||

          request.resource.data.status
              == "cancelled"
        )

        && (
          (
            request.resource.data.status
                == "paid"

            && request.resource.data.paidAt
                == request.time
          )

          ||

          (
            request.resource.data.status
                != "paid"

            && request.resource.data.paidAt
                == null
          )
        )

        && request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasOnly([
              "status",
              "paidAt"
            ]);


      allow delete:
        if isAdmin();
    }


    // ==================================================
    // MODERAÇÃO GLOBAL
    // ==================================================

    // Um documento representa o estado atual da
    // penalidade de cada usuário.
    //
    // warning = advertência
    // mute    = não pode enviar mensagens
    // ban     = bloqueia principais interações
    //
    match /moderationPenalties/{uid} {

      allow get:
        if isOwner(uid)
        || isAdmin();

      allow list:
        if isAdmin();


      allow create:
        if isAdmin()

        && request.resource.data.uid
            == uid

        && request.resource.data.type
            in [
              "warning",
              "mute",
              "ban"
            ]

        && request.resource.data.reason
            is string

        && request.resource.data.reason.size()
            >= 1

        && request.resource.data.reason.size()
            <= 500

        && request.resource.data.active
            == true

        && (
          request.resource.data.expiresAt
              == null

          ||

          request.resource.data.expiresAt
              is timestamp
        )

        && request.resource.data.createdBy
            == request.auth.uid

        && request.resource.data.createdAt
            == request.time

        && request.resource.data.updatedAt
            == request.time

        && request.resource.data.keys().hasOnly([
          "uid",
          "type",
          "reason",
          "active",
          "expiresAt",
          "createdBy",
          "createdAt",
          "updatedAt"
        ]);


      allow update:
        if isAdmin()

        && request.resource.data.uid
            == resource.data.uid

        && request.resource.data.createdBy
            == resource.data.createdBy

        && request.resource.data.createdAt
            == resource.data.createdAt

        && request.resource.data.type
            in [
              "warning",
              "mute",
              "ban"
            ]

        && request.resource.data.reason
            is string

        && request.resource.data.reason.size()
            >= 1

        && request.resource.data.reason.size()
            <= 500

        && request.resource.data.active
            is bool

        && (
          request.resource.data.expiresAt
              == null

          ||

          request.resource.data.expiresAt
              is timestamp
        )

        && request.resource.data.updatedAt
            == request.time

        && request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasOnly([
              "type",
              "reason",
              "active",
              "expiresAt",
              "updatedAt"
            ]);


      // Histórico não deve sumir silenciosamente.
      // Para encerrar: active = false.
      allow delete:
        if false;
    }


    // Histórico imutável das ações administrativas.
    match /moderationActions/{actionId} {

      allow read:
        if isAdmin();


      allow create:
        if isAdmin()

        && request.resource.data.targetUid
            is string

        && request.resource.data.targetUid.size()
            >= 1

        && request.resource.data.targetUid.size()
            <= 128

        && request.resource.data.action
            in [
              "apply",
              "revoke"
            ]

        && request.resource.data.type
            in [
              "none",
              "warning",
              "mute",
              "ban"
            ]

        && request.resource.data.reason
            is string

        && request.resource.data.reason.size()
            >= 1

        && request.resource.data.reason.size()
            <= 500

        && request.resource.data.moderatorUid
            == request.auth.uid

        && (
          request.resource.data.expiresAt
              == null

          ||

          request.resource.data.expiresAt
              is timestamp
        )

        && request.resource.data.createdAt
            == request.time

        && request.resource.data.keys().hasOnly([
          "targetUid",
          "type",
          "reason",
          "action",
          "moderatorUid",
          "expiresAt",
          "createdAt"
        ]);


      allow update, delete:
        if false;
    }


    // ==================================================
    // CATEGORIAS
    // ==================================================

    match /categories/{categoryId} {

      allow read:
        if true;

      allow create, update, delete:
        if isAdmin();
    }


    // ==================================================
    // STREAMERS DESTACADOS MANUALMENTE
    // ==================================================

    match /featuredStreamers/{uid} {

      allow read:
        if true;

      allow create, update, delete:
        if isAdmin();
    }


    // ==================================================
    // PRESENÇA DE ESPECTADORES
    // ==================================================

    match /streams/{streamId}/viewers/{viewerUid} {

      allow read:
        if loggedIn();


      allow create:
        if isOwner(viewerUid)

        && request.resource.data.uid
            == viewerUid

        && request.resource.data.joinedAt
            == request.time

        && request.resource.data.lastSeen
            == request.time

        && request.resource.data.keys().hasOnly([
          "uid",
          "joinedAt",
          "lastSeen"
        ]);


      allow update:
        if isOwner(viewerUid)

        && request.resource.data.uid
            == resource.data.uid

        && request.resource.data.joinedAt
            == resource.data.joinedAt

        && request.resource.data.lastSeen
            == request.time

        && request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasOnly([
              "lastSeen"
            ]);


      allow delete:
        if isOwner(viewerUid)

        || isAdmin()

        ||

        (
          loggedIn()

          && get(
            /databases/$(database)/documents/streams/$(streamId)
          ).data.streamerUid == request.auth.uid
        );
    }


    // ==================================================
    // GOVERNANÇA / DENÚNCIAS
    // ==================================================

    function reportsEnabled() {
      return exists(
          /databases/$(database)/documents/governance/config
        )

        && get(
          /databases/$(database)/documents/governance/config
        ).data.reportsEnabled == true

        && get(
          /databases/$(database)/documents/governance/config
        ).data.rulesVersion == "governance-1";
    }

    function reportIdValid(id) {
      return id is string
        && id.matches(
          '^[A-Za-z0-9_-]{1,128}$'
        );
    }

    function validReportTarget(d) {
      return reportIdValid(
          d.targetId
        )

        && reportIdValid(
          d.contextId
        )

        && (
          (
            d.targetType == "profile"

            && d.contextId == "-"

            && d.targetId
                != request.auth.uid

            && exists(
              /databases/$(database)/documents/profiles/$(d.targetId)
            )
          )

          ||

          (
            d.targetType == "stream"

            && d.contextId == "-"

            && exists(
              /databases/$(database)/documents/streams/$(d.targetId)
            )

            && get(
              /databases/$(database)/documents/streams/$(d.targetId)
            ).data.streamerUid
                != request.auth.uid
          )

          ||

          (
            d.targetType == "chat"

            && exists(
              /databases/$(database)/documents/streams/$(d.contextId)
            )

            && exists(
              /databases/$(database)/documents/streams/$(d.contextId)/chat/$(d.targetId)
            )

            && get(
              /databases/$(database)/documents/streams/$(d.contextId)/chat/$(d.targetId)
            ).data.uid
                != request.auth.uid
          )
        );
    }

    function reportCreateValid(id, d) {
      return loggedIn()

        && request.auth.token.email_verified
            == true

        && reportsEnabled()

        && d.keys().hasOnly([
          "reporterUid",
          "targetType",
          "targetId",
          "contextId",
          "reason",
          "description",
          "key",
          "status",
          "createdAt"
        ])

        && d.reporterUid
            == request.auth.uid

        && d.status
            == "open"

        && d.createdAt
            == request.time

        && reportIdValid(id)

        && validReportTarget(d)

        && d.reason in [
          "child_safety",
          "sexual",
          "violence",
          "hate",
          "harassment",
          "privacy",
          "self_harm",
          "fraud",
          "malware",
          "spam",
          "copyright",
          "impersonation",
          "other"
        ]

        && d.description
            is string

        && d.description.size()
            <= 1000

        && d.key
            == d.targetType
               + ":"
               + d.contextId
               + ":"
               + d.targetId

        && getAfter(
          /databases/$(database)/documents/reportKeys/$(request.auth.uid)/targets/$(d.key)
        ).data.reportId
            == id

        && getAfter(
          /databases/$(database)/documents/reportKeys/$(request.auth.uid)/targets/$(d.key)
        ).data.updatedAt
            == request.time

        && getAfter(
          /databases/$(database)/documents/reportLimits/$(request.auth.uid)
        ).data.reportId
            == id

        && getAfter(
          /databases/$(database)/documents/reportLimits/$(request.auth.uid)
        ).data.lastAt
            == request.time;
    }

    function newOwnReport(id, uid) {
      let d = getAfter(
        /databases/$(database)/documents/reports/$(id)
      ).data;

      return !exists(
          /databases/$(database)/documents/reports/$(id)
        )

        && d.reporterUid
            == uid

        && d.createdAt
            == request.time

        && d.status
            == "open";
    }


    match /governance/config {

      allow get:
        if true;

      allow list, write:
        if false;
    }


    match /reports/{id} {

      allow get:
        if loggedIn()

        && (
          isAdmin()

          ||

          resource.data.reporterUid
              == request.auth.uid
        );


      allow list:
        if loggedIn()

        && request.query.limit
            <= 50

        && (
          isAdmin()

          ||

          resource.data.reporterUid
              == request.auth.uid
        );


      allow create:
        if reportCreateValid(
          id,
          request.resource.data
        );


      allow update:
        if isAdmin()

        && resource.data.status
            == "open"

        && request.resource.data.status
            == "closed"

        && request.resource.data.resolution
            in [
              "no_violation",
              "insufficient",
              "target_unavailable",
              "reviewed"
            ]

        && request.resource.data.reviewedAt
            == request.time

        && request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasOnly([
              "status",
              "resolution",
              "reviewedAt"
            ])

        && !exists(
          /databases/$(database)/documents/moderationAudit/$(id)
        )

        && getAfter(
          /databases/$(database)/documents/moderationAudit/$(id)
        ).data.resolution
            == request.resource.data.resolution

        && getAfter(
          /databases/$(database)/documents/moderationAudit/$(id)
        ).data.moderatorUid
            == request.auth.uid

        && getAfter(
          /databases/$(database)/documents/moderationAudit/$(id)
        ).data.createdAt
            == request.time;


      allow delete:
        if false;
    }


    match /reportLimits/{uid} {

      allow get:
        if isOwner(uid);

      allow list, delete:
        if false;


      allow create, update:
        if isOwner(uid)

        && request.resource.data.keys().hasOnly([
          "reportId",
          "lastAt"
        ])

        && request.resource.data.lastAt
            == request.time

        && (
          !exists(
            /databases/$(database)/documents/reportLimits/$(uid)
          )

          ||

          resource.data.lastAt
              + duration.value(60, "s")
              <= request.time
        )

        && newOwnReport(
          request.resource.data.reportId,
          uid
        );
    }


    match /reportKeys/{uid}/targets/{key} {

      allow get:
        if isOwner(uid);

      allow list, delete:
        if false;


      allow create, update:
        if isOwner(uid)

        && request.resource.data.keys().hasOnly([
          "reportId",
          "updatedAt"
        ])

        && request.resource.data.updatedAt
            == request.time

        && newOwnReport(
          request.resource.data.reportId,
          uid
        )

        && getAfter(
          /databases/$(database)/documents/reports/$(request.resource.data.reportId)
        ).data.key
            == key

        && (
          !exists(
            /databases/$(database)/documents/reportKeys/$(uid)/targets/$(key)
          )

          ||

          get(
            /databases/$(database)/documents/reports/$(resource.data.reportId)
          ).data.status
              == "closed"
        );
    }


    match /moderationAudit/{id} {

      allow get:
        if isAdmin();

      allow list:
        if isAdmin()
        && request.query.limit <= 50;


      allow create:
        if isAdmin()

        && request.resource.data.keys().hasOnly([
          "reportId",
          "action",
          "resolution",
          "moderatorUid",
          "createdAt"
        ])

        && request.resource.data.reportId
            == id

        && request.resource.data.action
            == "close_report"

        && request.resource.data.moderatorUid
            == request.auth.uid

        && request.resource.data.createdAt
            == request.time

        && get(
          /databases/$(database)/documents/reports/$(id)
        ).data.status
            == "open"

        && getAfter(
          /databases/$(database)/documents/reports/$(id)
        ).data.status
            == "closed"

        && getAfter(
          /databases/$(database)/documents/reports/$(id)
        ).data.reviewedAt
            == request.time

        && getAfter(
          /databases/$(database)/documents/reports/$(id)
        ).data.resolution
            == request.resource.data.resolution;


      allow update, delete:
        if false;
    }


    // ==================================================
    // ACEITE DE POLÍTICAS
    // ==================================================

    match /policyAcceptances/{uid}/versions/{version} {

      allow get:
        if isOwner(uid)
        || isAdmin();

      allow list:
        if isOwner(uid)
        || isAdmin();


      allow create:
        if isOwner(uid)

        && get(
          /databases/$(database)/documents/governance/config
        ).data.termsEffective == true

        && version
            == get(
              /databases/$(database)/documents/governance/config
            ).data.termsVersion

        && request.resource.data.keys().hasOnly([
          "uid",
          "termsVersion",
          "privacyVersion",
          "acceptedAt"
        ])

        && request.resource.data.uid
            == uid

        && request.resource.data.termsVersion
            == version

        && request.resource.data.privacyVersion
            == get(
              /databases/$(database)/documents/governance/config
            ).data.privacyVersion

        && request.resource.data.acceptedAt
            == request.time;


      allow update, delete:
        if false;
    }


    // ==================================================
    // BLOQUEIO FINAL
    // ==================================================

    match /{document=**} {

      allow read, write:
        if false;
    }
  }
}